{
  "name": "@office/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "prepare": "npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:policy": "npm run build && node scripts/tool-policy.test.mjs",
    "lint": "npm run lint --prefix ../..",
    "lint:fix": "npm run lint:fix --prefix ../..",
    "format": "npm run format --prefix ../.."
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
